diff --git a/packages/core/tests/unit/plugins/content-create-references.test.ts b/packages/core/tests/unit/plugins/content-create-references.test.ts
new file mode 100644
index 0000000..bcb90d4
--- /dev/null
+++ b/packages/core/tests/unit/plugins/content-create-references.test.ts
@@ -0,0 +1,35 @@
+import { describe, expect, it } from "vitest";
+
+import { createContentAccessWithWrite } from "../../../src/plugins/context.js";
+
+// The database is never reached in these cases: the runtime callback stands in
+// for the create handler, and the direct path refuses before any query.
+const db = {} as never;
+
+describe("plugin content.create references (Powerfarm patch 0002)", () => {
+	it("forwards references to the runtime create pipeline unchanged", async () => {
+		const seen: unknown[] = [];
+		const access = createContentAccessWithWrite(db, undefined, undefined, async (call) => {
+			seen.push(call.options?.references);
+			return { id: "c1", type: call.collection, slug: null, status: "draft", data: call.input, createdAt: "", updatedAt: "" } as never;
+		});
+		await access.create("contracts", { title: "Contract" }, { references: { client: ["entry_1"], products: ["p1", "p2"] } });
+		expect(seen).toEqual([{ client: ["entry_1"], products: ["p1", "p2"] }]);
+	});
+
+	it("rejects malformed reference selections before writing", async () => {
+		let called = false;
+		const access = createContentAccessWithWrite(db, undefined, undefined, async () => {
+			called = true;
+			return {} as never;
+		});
+		await expect(access.create("contracts", { title: "x" }, { references: { client: "entry_1" } as never })).rejects.toThrow(/array of entry ids/);
+		await expect(access.create("contracts", { title: "x" }, { references: [] as never })).rejects.toThrow(/field slug/);
+		expect(called).toBe(false);
+	});
+
+	it("refuses references on the direct path that has no create handler", async () => {
+		const access = createContentAccessWithWrite(db);
+		await expect(access.create("contracts", { title: "x" }, { references: { client: ["e1"] } })).rejects.toThrow(/runtime content pipeline/);
+	});
+});
