index b657658..ffcc472 100644
--- a/packages/core/src/plugins/context.ts
+++ b/packages/core/src/plugins/context.ts
@@ -1462,6 +1462,7 @@ function toUserInfo(user: {
 	name: string | null;
 	role: number;
 	createdAt: string;
+	emailVerified?: boolean;
 }): UserInfo {
 	return {
 		id: user.id,
@@ -1469,6 +1470,7 @@ function toUserInfo(user: {
 		name: user.name,
 		role: user.role,
 		createdAt: user.createdAt,
+		...(typeof user.emailVerified === "boolean" ? { emailVerified: user.emailVerified } : {}),
 	};
 }
 
