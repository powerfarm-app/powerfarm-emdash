	"content": {
		"blueprints": [
			{
				"id": "bp-client-onboarding",
				"slug": "bp-client-onboarding",
				"status": "draft",
				"data": {
					"title": "Client onboarding",
					"code": "BP-CLIENT-ONBOARDING",
					"target_collection": "clients",
					"trigger": "registered",
					"description": "When a client registration is approved: owner, identity, classification and access reviews, product links, a draft agreement for review, a maintenance plan.",
					"steps": [
						{
							"id": "owner",
							"action": "create_task",
							"title": "Confirm the accountable owner for {{subject.title}}",
							"pillar": "authority",
							"description": "Set the client's Accountable owner in the editor and publish.",
							"dueInDays": 3,
							"when": {
								"reference": "owner",
								"empty": true
							}
						},
						{
							"id": "identity",
							"action": "create_task",
							"title": "Verify the identity of {{subject.title}}",
							"pillar": "identity",
							"assignee": "$subject.owner",
							"description": "Check each identifier with its issuer. Record an identity_verified attestation (Evidence, subject {{subject.ref}}) naming the identifier; attach the issuer's record if you have it.",
							"dueInDays": 7
						},
						{
							"id": "classification",
							"action": "create_task",
							"title": "Review the classification of {{subject.title}} ({{subject.classification}})",
							"pillar": "security",
							"assignee": "$subject.owner",
							"description": "Confirm the classification fits the information held. Record a classification_reviewed attestation.",
							"dueInDays": 7
						},
						{
							"id": "access",
							"action": "create_task",
							"title": "Review who may access {{subject.title}}'s records",
							"pillar": "authority",
							"description": "Confidential and restricted clients need an administrator's access_reviewed attestation before activation.",
							"dueInDays": 7,
							"when": {
								"field": "classification",
								"in": [
									"confidential",
									"restricted"
								]
							}
						},
						{
							"id": "links",
							"action": "request_link",
							"title": "Link the products and shared services {{subject.title}} uses",
							"pillar": "general",
							"description": "Select existing Products on the client and publish. Do not register a second copy of a service that is already in the catalogue.",
							"when": {
								"reference": "products",
								"empty": true
							}
						},
						{
							"id": "contract",
							"action": "create_record",
							"collection": "contracts",
							"fields": {
								"title": "Agreement with {{subject.title}}",
								"contract_kind": "msa"
							},
							"references": {
								"client": [
									"$subject"
								],
								"products": [
									"$subject.products"
								],
								"owner": [
									"$subject.owner"
								]
							}
						},
						{
							"id": "contract_review",
							"action": "request_approval",
							"title": "Review the draft agreement for {{subject.title}}",
							"requiredRole": 50,
