---
// Finishes a Cloudflare Access sign-in through Powerfarm's OIDC provider.
//
// No logic lives here: the page posts the request id to the plugin's private
// route `oidc/continue` with EmDash's CSRF header (same-origin, session cookie)
// and follows the answer. Not signed in → EmDash's own sign-in, then back here.
// Cloudflare Access must Bypass this path (docs/IDENTITY.md).
import "@powerfarm/emdash-plugin/brand/tokens.css";
import { Font } from "astro:assets";

import Mark from "../../components/Mark.astro";

export const prerender = true;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="referrer" content="no-referrer" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<Font cssVariable="--font-emdash" preload />
		<title>Signing in — Powerfarm</title>
	</head>
	<body>
		<main>
			<Mark class="mark" />
			<p id="status" role="status" aria-live="polite">Signing you in…</p>
			<div class="progress" aria-hidden="true"></div>
		</main>
		<script is:inline>
			(async () => {
				const status = document.getElementById("status");
				const fail = (message) => {
					status.textContent = message;
					document.body.dataset.state = "error";
				};
				const rid = new URLSearchParams(location.search).get("rid") || "";
				if (!/^[A-Za-z0-9_-]{16,64}$/.test(rid)) {
					fail("This sign-in link is not valid. Start again from the application.");
					return;
				}
				let res;
				try {
					res = await fetch("/_emdash/api/plugins/powerfarm/oidc/continue", {
						method: "POST",
						credentials: "same-origin",
						headers: { "content-type": "application/json", "x-emdash-request": "1" },
						body: JSON.stringify({ rid }),
					});
				} catch {
					fail("Could not reach Powerfarm. Try again.");
					return;
				}
				if (res.status === 401) {
					location.replace("/_emdash/admin/login?redirect=" + encodeURIComponent("/oidc/continue?rid=" + rid));
					return;
				}
				const body = await res.json().catch(() => null);
				const target = body && body.data && body.data.location;
				if (res.ok && typeof target === "string" && /^https:\/\//.test(target)) {
					location.replace(target);
					return;
				}
				fail((body && body.error && body.error.message) || "Sign-in could not be completed.");
			})();
		</script>
		<style>
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				background: var(--pf-bg);
				color: var(--pf-ink);
				font-family: var(--pf-font);
				-webkit-font-smoothing: antialiased;
			}
			main {
				display: grid;
				justify-items: center;
				gap: 1.25rem;
				padding: 2rem 16px;
				max-width: 22rem;
				text-align: center;
			}
			.mark {
				width: 3rem;
				height: 3rem;
			}
			p {
				margin: 0;
				font-size: 0.9375rem;
			}
			.progress {
				width: 8rem;
				height: 2px;
				background: var(--pf-line);
				position: relative;
				overflow: hidden;
			}
			.progress::after {
				content: "";
				position: absolute;
				inset: 0;
				width: 40%;
				background: var(--pf-detail);
				animation: pf-progress 1.2s var(--pf-ease) infinite;
			}
			@keyframes pf-progress {
				from {
					transform: translateX(-100%);
				}
				to {
					transform: translateX(250%);
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.progress::after {
					animation: none;
					width: 100%;
					opacity: 0.5;
				}
			}
			body[data-state="error"] p {
				color: var(--pf-error);
			}
			body[data-state="error"] .progress {
				display: none;
			}
		</style>
	</body>
</html>
