---
// Internal instance landing page. Everything happens in the EmDash admin.
import "@powerfarm/emdash-plugin/brand/tokens.css";
import { Font } from "astro:assets";

import Mark from "../components/Mark.astro";
import Wordmark from "../components/Wordmark.astro";

const shortcuts = [
	{ href: "/_emdash/admin/plugins/powerfarm/recovery", label: "Recovery", note: "Mission 001" },
	{ href: "/_emdash/admin/plugins/powerfarm/graph", label: "Graph", note: "People, machines, agents" },
	{ href: "/_emdash/admin/plugins/powerfarm/engineering", label: "Engineering", note: "Jobs and the bridge" },
	{ href: "/_emdash/admin/plugins/powerfarm/audit", label: "Audit and health", note: "Journal and checks" },
	{ href: "/_emdash/admin/content/recovery_operations", label: "Recovery operations", note: "Content" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<Font cssVariable="--font-emdash" preload />
		<title>Powerfarm</title>
	</head>
	<body>
		<main>
			<header>
				<Mark class="mark" />
				<Wordmark class="wordmark" />
			</header>

			<p class="eyebrow"><span class="dot" aria-hidden="true"></span>Internal · signed-in people only</p>
			<h1>Everything happens in the admin.</h1>

			<a class="primary" href="/_emdash/admin">Open the admin</a>

			<nav aria-label="Shortcuts">
				<ul>
					{
						shortcuts.map((s) => (
							<li>
								<a href={s.href}>
									<span class="label">{s.label}</span>
									<span class="note">{s.note}</span>
									<span class="arrow" aria-hidden="true">→</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</main>
		<style>
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				background: var(--pf-bg);
				color: var(--pf-ink);
				font-family: var(--pf-font);
				-webkit-font-smoothing: antialiased;
			}
			main {
				width: 100%;
				max-width: 30rem;
				padding: 3rem 16px;
				box-sizing: border-box;
			}
			header {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 3rem;
			}
			.mark {
				width: 2.25rem;
				height: 2.25rem;
				flex: none;
			}
			.wordmark {
				height: 1.35rem;
				width: auto;
			}
			.eyebrow {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin: 0;
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--pf-ink-subtle);
			}
			.dot {
				width: 0.375rem;
				height: 0.375rem;
				border-radius: 50%;
				background: var(--pf-detail);
			}
			h1 {
				margin: 0.5rem 0 1.75rem;
				font-size: 1.75rem;
				line-height: 1.2;
				font-weight: 650;
				letter-spacing: -0.01em;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			a:focus-visible {
				outline: 2px solid var(--pf-focus);
				outline-offset: 2px;
			}
			.primary {
				display: inline-block;
				padding: 0.7rem 1.25rem;
				background: var(--pf-action);
				color: var(--pf-action-ink);
				font-weight: 600;
				font-size: 0.9375rem;
				transition: background var(--pf-motion-fast) var(--pf-ease);
			}
			.primary:hover {
				background: var(--pf-action-hover);
			}
			nav {
				margin-top: 2.5rem;
				border-top: 1px solid var(--pf-line);
			}
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li a {
				display: grid;
				grid-template-columns: 1fr auto;
				grid-template-areas: "label arrow" "note arrow";
				padding: 0.85rem 0.25rem;
				border-bottom: 1px solid var(--pf-line);
				transition: background var(--pf-motion-fast) var(--pf-ease);
			}
			li a:hover {
				background: var(--pf-surface);
			}
			.label {
				grid-area: label;
				font-weight: 600;
			}
			.note {
				grid-area: note;
				font-size: 0.8125rem;
				color: var(--pf-ink-subtle);
			}
			.arrow {
				grid-area: arrow;
				align-self: center;
				color: var(--pf-link);
				transition: transform var(--pf-motion-fast) var(--pf-ease);
			}
			li a:hover .arrow {
				transform: translateX(3px);
			}
		</style>
	</body>
</html>
