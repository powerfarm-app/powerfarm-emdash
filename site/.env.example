# Powerfarm internal instance. Copy to .env (and to the systemd EnvironmentFile).

# The VM's address on UTM's network, so the bridge on macOS can reach EmDash.
HOST=192.168.64.2
PORT=4321
EMDASH_SITE_URL=http://192.168.64.2:4321

# Where the database, media and uploads live. Backups and restores use the same value.
POWERFARM_DATA_DIR=/var/lib/powerfarm

# Encrypts plugin secrets (the bridge signing secret). Generate: openssl rand -base64 32
# Store a copy OUTSIDE this machine (password manager or offline). Without it,
# a restored database cannot read the bridge secret. It is never written into backups.
EMDASH_ENCRYPTION_KEY=

# Require authentication for media files, including evidence (upstream/patches/0001).
EMDASH_PRIVATE_MEDIA=1

# Leave unset for SQLite (recommended for Mission 001).
# DATABASE_URL=postgres://...
